<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dflex_partner_balance_group_import_wizard_form" model="ir.ui.view">
        <field name="name">dflex.partner.balance.group.import.wizard.form</field>
        <field name="model">dflex.partner.balance.group.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar saldos clientes por grupo">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="journal_id"/>
                        <field name="report_group"/>
                        <field name="receivable_account_id"/>
                        <field name="capital_account_id"/>
                        <field name="accounting_date"/>
                        <field name="create_missing_partners"/>
                        <field name="dry_run"/>
                        <field name="post_move"/>
                    </group>
                    <group>
                        <field name="csv_file" filename="csv_filename"/>
                        <field name="csv_filename" invisible="1"/>
                    </group>
                    <group string="Resultado">
                        <field name="result" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Importar / Simular" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dflex_partner_balance_group_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar saldos clientes por grupo</field>
        <field name="res_model">dflex.partner.balance.group.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_dflex_partner_balance_group_import_wizard"
              name="Importar saldos clientes por grupo"
              parent="account.menu_finance_receivables"
              action="action_dflex_partner_balance_group_import_wizard"
              sequence="96"/>
</odoo>
