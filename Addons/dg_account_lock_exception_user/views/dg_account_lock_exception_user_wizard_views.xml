<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dg_account_lock_exception_user_wizard_form" model="ir.ui.view">
        <field name="name">dg.account.lock.exception.user.wizard.form</field>
        <field name="model">dg.account.lock.exception.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Desbloquear asientos por usuario">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Esta acción crea una excepción de bloqueo contable solo para el usuario elegido. No habilita a todos los usuarios.
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="lock_date_field"/>
                        <field name="company_lock_date" readonly="1"/>
                        <field name="lock_date"/>
                        <field name="end_datetime"/>
                        <field name="reason"/>
                    </group>
                    <div class="text-muted">
                        Ejemplo: si la compañía tiene bloqueado hasta 30/04/2026 y querés permitirle a un usuario operar en abril, indicá 31/03/2026 como nueva fecha de bloqueo para ese usuario.
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_exception" string="Crear excepción" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dg_account_lock_exception_user_wizard" model="ir.actions.act_window">
        <field name="name">Desbloqueos contables por usuario</field>
        <field name="res_model">dg.account.lock.exception.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <menuitem
        id="menu_dg_account_lock_exception_user_wizard"
        name="Desbloqueos por usuario"
        parent="account.menu_finance_configuration"
        action="action_dg_account_lock_exception_user_wizard"
        groups="account.group_account_manager"
        sequence="90"/>
</odoo>
