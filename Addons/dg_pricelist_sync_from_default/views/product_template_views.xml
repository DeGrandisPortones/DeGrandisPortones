<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dg_product_template_form_view_same_price" model="ir.ui.view">
        <field name="name">product.template.form.dg.same.price.all.pricelists</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="dg_keep_same_price_all_pricelists" invisible="not sale_ok"/>
            </xpath>
        </field>
    </record>
</odoo>
