<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_journal_form_dg_supplier_report" model="ir.ui.view">
        <field name="name">account.journal.form.dg.supplier.report</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="dg_supplier_report_group"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_dg_supplier_report_group" model="ir.ui.view">
        <field name="name">account.move.form.dg.supplier.report.group</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//field[@name='partner_id']" position="after">
                <field name="dg_supplier_report_group" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_dg_supplier_report_line_search" model="ir.ui.view">
        <field name="name">dg.supplier.report.line.search</field>
        <field name="model">dg.supplier.report.line</field>
        <field name="arch" type="xml">
            <search string="Reporte de proveedores">
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="move_name"/>
                <field name="journal_id"/>
                <field name="invoice_date"/>
                <filter string="Subtotal FCA" name="filter_fca" domain="[('report_group', '=', 'fca')]"/>
                <filter string="Subtotal Internas" name="filter_internas" domain="[('report_group', '=', 'internas')]"/>
                <separator/>
                <filter string="Facturas" name="filter_in_invoice" domain="[('move_type', '=', 'in_invoice')]"/>
                <filter string="Notas de crédito" name="filter_in_refund" domain="[('move_type', '=', 'in_refund')]"/>
                <filter string="Saldos iniciales / ajustes" name="filter_opening_balance" domain="[('source_type', '=', 'opening_balance')]"/>
                <filter string="Pagos / debitos sin aplicar" name="filter_payment_debit" domain="[('source_type', '=', 'payment_debit')]"/>
                <filter string="Con saldo" name="filter_unpaid" domain="[('amount_residual_signed', '!=', 0)]"/>
                <separator/>
                <filter string="Agrupar por proveedor" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por subtotal" name="group_by_report_group" context="{'group_by': 'report_group'}"/>
                <filter string="Agrupar por origen" name="group_by_source_type" context="{'group_by': 'source_type'}"/>
                <filter string="Agrupar por diario" name="group_by_journal" context="{'group_by': 'journal_id'}"/>
                <filter string="Agrupar por mes" name="group_by_invoice_month" context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_dg_supplier_report_line_list" model="ir.ui.view">
        <field name="name">dg.supplier.report.line.list</field>
        <field name="model">dg.supplier.report.line</field>
        <field name="arch" type="xml">
            <list string="Reporte de proveedores" create="0" edit="0" delete="0" default_order="partner_id, report_group, invoice_date, move_id">
                <field name="partner_id"/>
                <field name="report_group"/>
                <field name="source_type" optional="show"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due" optional="show"/>
                <field name="move_id"/>
                <field name="line_id" optional="hide"/>
                <field name="journal_id" optional="show"/>
                <field name="move_type" optional="hide"/>
                <field name="payment_state" optional="show"/>
                <field name="amount_untaxed_signed" widget="monetary" sum="Base imponible"/>
                <field name="amount_tax_signed" widget="monetary" sum="Impuestos"/>
                <field name="amount_total_signed" widget="monetary" sum="Total"/>
                <field name="amount_residual_signed" widget="monetary" sum="Saldo"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dg_supplier_report_line_form" model="ir.ui.view">
        <field name="name">dg.supplier.report.line.form</field>
        <field name="model">dg.supplier.report.line</field>
        <field name="arch" type="xml">
            <form string="Reporte de proveedores" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_move" type="object" string="Abrir comprobante" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="report_group"/>
                            <field name="source_type"/>
                            <field name="move_id"/>
                            <field name="line_id"/>
                            <field name="journal_id"/>
                            <field name="move_type"/>
                            <field name="payment_state"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="accounting_date"/>
                            <field name="invoice_date_due"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="company_currency_id"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <field name="amount_untaxed_signed" widget="monetary"/>
                        <field name="amount_tax_signed" widget="monetary"/>
                        <field name="amount_total_signed" widget="monetary"/>
                        <field name="amount_residual_signed" widget="monetary"/>
                    </group>
                    <group string="Referencias">
                        <field name="move_name"/>
                        <field name="ref"/>
                        <field name="invoice_origin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dg_supplier_report_line" model="ir.actions.act_window">
        <field name="name">Reporte de proveedores</field>
        <field name="res_model">dg.supplier.report.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dg_supplier_report_line_search"/>
        <field name="context">{'search_default_group_by_partner': 1, 'search_default_group_by_report_group': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay movimientos publicados en los diarios configurados ni saldos iniciales clasificados.
            </p>
        </field>
    </record>

    <menuitem id="menu_dg_supplier_report_line"
              name="Reporte de proveedores"
              parent="account.menu_finance_reports"
              action="action_dg_supplier_report_line"
              sequence="36"
              groups="account.group_account_user"/>
</odoo>
