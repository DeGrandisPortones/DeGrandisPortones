<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_dflex_own_check_opening_import_wizard_form" model="ir.ui.view">
    <field name="name">dflex.own.check.opening.import.wizard.form</field>
    <field name="model">dflex.own.check.opening.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Importar cheques propios en circulacion">
        <sheet>
          <group>
            <field name="file" filename="filename" required="1"/>
            <field name="filename" invisible="1"/>
          </group>
          <group string="Compania y diarios">
            <field name="company_id" required="1"/>
            <field name="bank_journal_id" required="1"/>
            <field name="opening_journal_id" required="1"/>
          </group>
          <group string="Cuentas">
            <field name="capital_account_id" required="1"/>
            <field name="own_check_account_id"/>
          </group>
          <group string="Opciones de seguridad">
            <field name="dry_run"/>
            <field name="post_opening_moves" invisible="dry_run"/>
            <field name="skip_existing"/>
            <field name="create_partners"/>
          </group>
          <group string="Formato CSV esperado">
            <div>
              <p>Columnas obligatorias: <b>number</b> e <b>amount</b>.</p>
              <p>Columnas opcionales: payment_date, issue_date, delivery_date, partner_vat, partner_name, type, state, note.</p>
              <p>Estados aceptados: delivered/entregado, pending_entry/por ingresar, expired/vencido. Si queda vacio, se calcula por fecha de pago.</p>
            </div>
          </group>
        </sheet>
        <footer>
          <button name="action_import" type="object" string="Validar / Importar" class="oe_highlight"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_dflex_own_check_opening_import_wizard" model="ir.actions.act_window">
    <field name="name">Importar cheques en circulacion</field>
    <field name="res_model">dflex.own.check.opening.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_dflex_own_check_opening_import"
            name="Importar cheques en circulacion"
            parent="dflex_checks.menu_dflex_checks_root"
            action="action_dflex_own_check_opening_import_wizard"
            sequence="30"/>
</odoo>
