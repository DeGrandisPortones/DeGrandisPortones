<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dg_resumen_cta_cte_summary_search" model="ir.ui.view">
        <field name="name">dg.resumen.cta.cte.summary.search</field>
        <field name="model">dg.resumen.cta.cte.summary</field>
        <field name="arch" type="xml">
            <search string="Resumen Cta Cte">
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter string="Con saldo FCA" name="with_fca" domain="[('subtotal_fca', '!=', 0)]"/>
                <filter string="Con saldo Internas" name="with_internas" domain="[('subtotal_internas', '!=', 0)]"/>
                <filter string="Con saldo total" name="with_total" domain="[('total_balance', '!=', 0)]"/>
            </search>
        </field>
    </record>

    <record id="view_dg_resumen_cta_cte_summary_list" model="ir.ui.view">
        <field name="name">dg.resumen.cta.cte.summary.list</field>
        <field name="model">dg.resumen.cta.cte.summary</field>
        <field name="arch" type="xml">
            <list string="Resumen Cta Cte" create="0" edit="0" delete="0" default_order="partner_id">
                <field name="partner_id"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="subtotal_fca" widget="monetary" sum="Subtotal FCA"/>
                <field name="subtotal_internas" widget="monetary" sum="Subtotal Internas"/>
                <field name="total_balance" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dg_resumen_cta_cte_summary_form" model="ir.ui.view">
        <field name="name">dg.resumen.cta.cte.summary.form</field>
        <field name="model">dg.resumen.cta.cte.summary</field>
        <field name="arch" type="xml">
            <form string="Resumen Cta Cte" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_partner" type="object" string="Abrir cliente"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Saldos">
                            <field name="subtotal_fca" widget="monetary"/>
                            <field name="subtotal_internas" widget="monetary"/>
                            <field name="total_balance" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dg_resumen_cta_cte_summary" model="ir.actions.act_window">
        <field name="name">Resumen Cta Cte</field>
        <field name="res_model">dg.resumen.cta.cte.summary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dg_resumen_cta_cte_summary_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay saldos para los filtros seleccionados.
            </p>
        </field>
    </record>
</odoo>
