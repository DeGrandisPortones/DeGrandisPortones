<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dg_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">dg.account.statement.wizard.form</field>
        <field name="model">dg.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen Cta Cte">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="partner_ids" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to" required="1"/>
                            <field name="include_initial_balance"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Primero ver el detalle. Luego, desde el listado de movimientos, usar Descargar resumen para imprimir el PDF.
                    </p>
                </sheet>
                <footer>
                    <button name="action_view_detail" type="object" string="Ver detalle" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dg_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">Resumen Cta Cte</field>
        <field name="res_model">dg.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_dg_account_statement_wizard"
              name="Resumen Cta Cte"
              parent="account.menu_finance_reports"
              action="action_dg_account_statement_wizard"
              sequence="36"
              groups="account.group_account_user"/>
</odoo>
