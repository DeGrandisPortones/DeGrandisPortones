<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <menuitem id="menu_dflex_checks_root"
            name="Cheques Propios"
            parent="accountant.menu_accounting"
            sequence="90"/>

  <record id="action_dflex_checkbook" model="ir.actions.act_window">
    <field name="name">Chequeras</field>
    <field name="res_model">dflex.checkbook</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <menuitem id="menu_dflex_checkbook"
            name="Chequeras"
            parent="menu_dflex_checks_root"
            action="action_dflex_checkbook"
            sequence="10"/>

  <record id="view_dflex_checkbook_list" model="ir.ui.view">
    <field name="name">dflex.checkbook.list</field>
    <field name="model">dflex.checkbook</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="journal_id"/>
        <field name="bank_id" optional="hide"/>
        <field name="type"/>
        <field name="start_number"/>
        <field name="quantity"/>
        <field name="last_number"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_dflex_checkbook_form" model="ir.ui.view">
    <field name="name">dflex.checkbook.form</field>
    <field name="model">dflex.checkbook</field>
    <field name="arch" type="xml">
      <form string="Chequera">
        <sheet>
          <group>
            <field name="name"/>
            <field name="journal_id" required="1"/>
            <field name="bank_id" readonly="1"/>
            <field name="type"/>
            <field name="start_number"/>
            <field name="quantity"/>
            <field name="last_number" readonly="1"/>
            <field name="state" readonly="1"/>
          </group>
          <group>
            <button name="action_generate_checks"
                    type="object"
                    string="Generar cheques"
                    class="oe_highlight"
                    invisible="state != 'draft'"/>
            <button name="action_close"
                    type="object"
                    string="Cerrar chequera"
                    invisible="state != 'generated'"/>
          </group>
          <notebook>
            <page string="Cheques">
              <field name="check_ids" context="{'default_journal_id': journal_id, 'default_type': type}">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="number"/>
                  <field name="type"/>
                  <field name="journal_id"/>
                  <field name="payment_date"/>
                  <field name="amount" sum="Total"/>
                  <field name="partner_id"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_dflex_check" model="ir.actions.act_window">
    <field name="name">Cheques</field>
    <field name="res_model">dflex.check</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <menuitem id="menu_dflex_check"
            name="Cheques"
            parent="menu_dflex_checks_root"
            action="action_dflex_check"
            sequence="20"/>

  <record id="view_dflex_check_list" model="ir.ui.view">
    <field name="name">dflex.check.list</field>
    <field name="model">dflex.check</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" string="Número"/>
        <field name="partner_name" string="Proveedor" optional="show"/>
        <field name="cuit_proveedor" string="CUIT" optional="show"/>
        <field name="amount_list_total" string="Importe" sum="Total"/>
        <field name="currency_id"/>
        <field name="checkbook_id"/>
        <field name="journal_id"/>
        <field name="type" string="Tipo de cheque"/>
        <field name="state"/>
        <field name="payment_date"/>
        <field name="delivery_date"/>
        <field name="partner_id" string="Entregado a"/>
        <field name="payment_id"/>
        <field name="debit_move_id" string="Asiento débito" optional="show"/>
        <field name="reversal_move_id" string="Asiento anulación/devolución" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_dflex_check_form" model="ir.ui.view">
    <field name="name">dflex.check.form</field>
    <field name="model">dflex.check</field>
    <field name="arch" type="xml">
      <form string="Cheque Propio">
        <header>
          <button name="action_reset_available" type="object" string="Volver a Disponible"
                  invisible="state in ['available','debited']"/>
          <button name="action_deliver" type="object" string="Entregar" class="oe_highlight"
                  invisible="state != 'available'"/>
          <button name="action_debit" type="object" string="Debitar cheque" class="oe_highlight"
                  invisible="state not in ['delivered','pending_entry','expired']"/>
          <button name="action_return" type="object" string="Marcar devuelto"
                  invisible="state not in ['delivered','pending_entry','expired']"/>
          <button name="action_cancel" type="object" string="Anular"
                  invisible="state == 'debited'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="available,delivered,pending_entry,expired,debited,returned,cancelled"/>
        </header>
        <sheet>
          <group>
            <field name="checkbook_id"/>
            <field name="name"/>
            <field name="number"/>
            <field name="type"/>
            <field name="journal_id"/>
            <field name="bank_id" readonly="1"/>
          </group>
          <group>
            <field name="issue_date"/>
            <field name="payment_date"/>
            <field name="delivery_date" readonly="1"/>
            <field name="amount" sum="Total"/>
            <field name="currency_id"/>
          </group>
          <group string="Entrega">
            <field name="partner_id"/>
            <field name="cuit_proveedor" readonly="1"/>
            <field name="partner_name" readonly="1"/>
          </group>
          <group>
            <field name="move_id" readonly="1"/>
            <field name="debit_move_id" readonly="1"/>
            <field name="reversal_move_id" readonly="1"/>
            <field name="payment_id" readonly="1"/>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_dflex_check_search" model="ir.ui.view">
    <field name="name">dflex.check.search</field>
    <field name="model">dflex.check</field>
    <field name="arch" type="xml">
      <search string="Buscar Cheques">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="journal_id"/>
        <filter name="available" string="Disponible" domain="[('state','=','available')]"/>
        <filter name="delivered" string="Entregados" domain="[('state','=','delivered')]"/>
        <filter name="pending_entry" string="Por ingresar" domain="[('state','=','pending_entry')]"/>
        <filter name="expired" string="Vencidos" domain="[('state','=','expired')]"/>
        <filter name="debited" string="Pagados" domain="[('state','=','debited')]"/>
        <filter name="returned" string="Devueltos" domain="[('state','=','returned')]"/>
        <filter name="cancelled" string="Anulados" domain="[('state','=','cancelled')]"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_journal" string="Diario banco" context="{'group_by':'journal_id'}"/>
          <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
          <filter name="group_book" string="Chequera" context="{'group_by':'checkbook_id'}"/>
        </group>
      </search>
    </field>
  </record>
</odoo>
