<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_account_payment_form_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.form.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="l10n_latam_check.view_account_payment_form_inherited"/>
    <field name="priority" eval="450"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_latam_new_check_ids']//field[@name='amount']" position="before">
        <field name="dflex_check_id"
               string="Cheque disponible"
               options="{'no_create': True, 'no_open': True}"
               column_invisible="parent.payment_method_code != 'own_checks'"
               domain="[('state','=','available'), ('company_id','=',parent.company_id), ('journal_id','=',parent.journal_id)]"/>
        <field name="dflex_check_type"
               string="Tipo propio"
               readonly="1"
               column_invisible="parent.payment_method_code != 'own_checks'"/>
      </xpath>

      <xpath expr="//field[@name='l10n_latam_new_check_ids']//field[@name='name']" position="attributes">
        <attribute name="string">Número</attribute>
      </xpath>

      <xpath expr="//field[@name='l10n_latam_new_check_ids']" position="after">
        <field name="dflex_own_check_total"
               string="Total cheques propios"
               readonly="1"
               invisible="payment_method_code != 'own_checks'"/>
      </xpath>

      <xpath expr="//header" position="inside">
        <button name="action_dflex_mark_check_returned"
                type="object"
                string="Marcar cheque devuelto"
                class="oe_highlight"
                invisible="state == 'draft' or payment_method_code != 'own_checks'"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_payment_list_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.list.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_tree"/>
    <field name="arch" type="xml">
      <xpath expr="(//tree|//list)[1]" position="inside">
        <field name="dflex_own_check_total" optional="hide"/>
      </xpath>
    </field>
  </record>
</odoo>
