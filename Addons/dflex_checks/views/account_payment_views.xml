<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_account_payment_form_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.form.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='payment_method_line_id']" position="after">
        <field name="dflex_check_id"
               string="Cheque propio"
               options="{'no_create': True}"
               domain="[('state', '=', 'available'), ('company_id', '=', company_id)]"
               invisible="payment_method_code != 'own_checks' or payment_type != 'outbound'"
               required="payment_method_code == 'own_checks' and payment_type == 'outbound'"/>
        <field name="dflex_check_payment_date"
               invisible="payment_method_code != 'own_checks' or payment_type != 'outbound'"
               required="payment_method_code == 'own_checks' and payment_type == 'outbound'"/>
        <field name="dflex_check_state" readonly="1" invisible="not dflex_check_id"/>
      </xpath>

      <xpath expr="//header" position="inside">
        <button name="action_dflex_mark_check_returned"
                type="object"
                string="Marcar cheque devuelto"
                class="oe_highlight"
                invisible="state not in ['posted', 'in_process', 'paid'] or not dflex_check_id or dflex_check_state != 'delivered'"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_payment_list_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.list.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_tree"/>
    <field name="arch" type="xml">
      <xpath expr="(//tree|//list)[1]" position="inside">
        <field name="dflex_check_id" optional="show"/>
        <field name="dflex_check_payment_date" optional="show"/>
        <field name="dflex_check_state" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
