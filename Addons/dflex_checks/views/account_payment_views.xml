<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Extensión de Pagos: vínculo con Cheque propio de cartera -->

  <record id="view_account_payment_form_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.form.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">

      <!-- Campos de cheque propio cerca del método de pago. Solo se usan en pagos salientes con Own Checks. -->
      <xpath expr="//field[@name='payment_method_line_id']" position="after">
        <field name="dflex_check_id"
               options="{'no_create': True}"
               invisible="payment_type != 'outbound' or payment_method_code != 'own_checks'"/>
        <field name="dflex_check_type"
               readonly="1"
               invisible="payment_type != 'outbound' or payment_method_code != 'own_checks' or not dflex_check_id"/>
        <field name="dflex_check_payment_date"
               required="dflex_check_id"
               invisible="payment_type != 'outbound' or payment_method_code != 'own_checks' or not dflex_check_id"/>
        <field name="dflex_check_state"
               readonly="1"
               invisible="payment_type != 'outbound' or payment_method_code != 'own_checks' or not dflex_check_id"/>
      </xpath>

      <!-- Acción para marcar devuelto por rechazo -->
      <xpath expr="//header" position="inside">
        <button name="action_dflex_mark_check_returned"
                type="object"
                string="Marcar cheque devuelto"
                class="oe_highlight"
                invisible="state == 'draft' or not dflex_check_id or dflex_check_state not in ['delivered','pending_entry']"/>
      </xpath>

    </field>
  </record>

  <record id="view_account_payment_list_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.list.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_tree"/>
    <field name="arch" type="xml">
      <xpath expr="(//tree|//list)[1]" position="inside">
        <field name="dflex_check_id" optional="hide"/>
        <field name="dflex_check_type" optional="hide"/>
        <field name="dflex_check_payment_date" optional="hide"/>
        <field name="dflex_check_state" optional="hide"/>
      </xpath>
    </field>
  </record>

</odoo>
