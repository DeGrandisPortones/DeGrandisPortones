<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Extensión de Pagos: múltiples cheques propios por pago -->

  <record id="view_account_payment_form_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.form.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="priority" eval="80"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page name="dflex_own_check_line_ids"
              string="Cheques propios"
              invisible="payment_type != 'outbound' or payment_method_code != 'own_checks'">
          <group>
            <field name="dflex_own_check_total" readonly="1"/>
          </group>
          <field name="dflex_check_line_ids"
                 nolabel="1"
                 readonly="state != 'draft'"
                 context="{'default_payment_id': id}">
            <list editable="bottom">
              <field name="company_id" column_invisible="1"/>
              <field name="journal_id" column_invisible="1"/>
              <field name="currency_id" column_invisible="1"/>
              <field name="check_id"
                     string="Número"
                     options="{'no_create': True, 'no_open': True}"
                     domain="[('state','=','available'), ('company_id','=',parent.company_id), ('journal_id','=',parent.journal_id)]"/>
              <field name="check_type" readonly="1"/>
              <field name="check_payment_date" string="Fecha del cheque"/>
              <field name="amount" widget="monetary" sum="Total"/>
              <field name="check_state" readonly="1" optional="hide"/>
              <field name="note" optional="hide"/>
            </list>
          </field>
        </page>
      </xpath>

      <xpath expr="//header" position="inside">
        <button name="action_dflex_mark_check_returned"
                type="object"
                string="Marcar cheque devuelto"
                class="oe_highlight"
                invisible="state == 'draft' or not dflex_check_line_ids"/>
      </xpath>
    </field>
  </record>

  <!-- Ocultar la solapa nativa de carga de cheques de terceros cuando el pago usa Own Checks.
       Para cheques propios se debe usar la solapa 'Cheques propios', que permite varias líneas. -->
  <record id="view_account_payment_form_hide_latam_checks_for_own_checks" model="ir.ui.view">
    <field name="name">account.payment.form.hide.latam.checks.for.own.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="l10n_latam_check.view_account_payment_form_inherited"/>
    <field name="priority" eval="400"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_latam_new_check_ids']/ancestor::page[1]" position="attributes">
        <attribute name="invisible" separator=" or " add="payment_method_code == 'own_checks'"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_payment_list_dflex_checks" model="ir.ui.view">
    <field name="name">account.payment.list.dflex.checks</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_tree"/>
    <field name="arch" type="xml">
      <xpath expr="(//tree|//list)[1]" position="inside">
        <field name="dflex_own_check_total" optional="hide"/>
      </xpath>
    </field>
  </record>
</odoo>
