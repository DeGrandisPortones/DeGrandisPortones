<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone (root_report_id=False): el frontend SÍ llama get_lines para standalone.
         Para variantes NO llama _dynamic_lines_generator (confirmado por logs v2.11.0).
         get_lines override delega a gl_root para aprovechar sus line_ids/expression_totals. -->
    <record id="general_ledger_no_carryforward_report" model="account.report">
        <field name="name">Mayor Sin Arrastre</field>
        <field name="root_report_id" eval="False"/>
        <field name="custom_handler_model_name">account.general.ledger.report.handler</field>
        <field name="filter_date_range" eval="True"/>
        <field name="default_opening_date_filter">this_month</field>
    </record>
</odoo>
