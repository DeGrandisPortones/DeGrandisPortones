<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Variante del GL con handler propio.
         Hereda line_ids, column_ids y filtros del root => data muestra correctamente.
         get_options override llama super() sobre sí mismo (variante) => sin loop. -->
    <record id="general_ledger_no_carryforward_report" model="account.report">
        <field name="name">Mayor Sin Arrastre</field>
        <field name="root_report_id" ref="account_reports.general_ledger_report"/>
        <field name="custom_handler_model_name">account.general.ledger.report.handler</field>
    </record>
</odoo>
