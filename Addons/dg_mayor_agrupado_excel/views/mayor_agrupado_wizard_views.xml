<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dg_mayor_agrupado_wizard_form" model="ir.ui.view">
        <field name="name">dg.mayor.agrupado.wizard.form</field>
        <field name="model">dg.mayor.agrupado.wizard</field>
        <field name="arch" type="xml">
            <form string="Mayor Agrupado por Factura (Excel)">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="account_ids" widget="many2many_tags"/>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object"
                            string="Exportar a Excel" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dg_mayor_agrupado_wizard" model="ir.actions.act_window">
        <field name="name">Mayor Agrupado por Factura (Excel)</field>
        <field name="res_model">dg.mayor.agrupado.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
