<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_dflex_purchase_process" model="ir.ui.view">
        <field name="name">purchase.order.form.dflex.purchase.process</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority" eval="450"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dflex_set_in_process"
                        type="object"
                        string="Pasar a En Proceso"
                        class="btn-primary"
                        invisible="dflex_purchase_process_state not in ['authorized', 'redo'] or state in ['cancel', 'done']"/>
                <button name="action_dflex_set_received"
                        type="object"
                        string="Acuse de recibo"
                        class="btn-primary"
                        invisible="dflex_purchase_process_state not in ['authorized', 'in_process'] or state in ['cancel', 'done']"/>
                <button name="action_dflex_set_paid"
                        type="object"
                        string="Marcar pagada"
                        invisible="dflex_purchase_process_state == 'paid' or state in ['cancel']"/>
                <button name="action_dflex_mark_executed"
                        type="object"
                        string="Marcar ejecutada"
                        class="btn-primary"
                        invisible="dflex_purchase_executed or state in ['cancel', 'done']"/>
                <button name="action_dflex_unmark_executed"
                        type="object"
                        string="Desmarcar ejecutada"
                        invisible="not dflex_purchase_executed or state in ['cancel', 'done']"/>
                <button name="action_dflex_force_redo"
                        type="object"
                        string="Rehacer orden"
                        invisible="dflex_purchase_process_state in ['redo', 'paid'] or state in ['cancel', 'done']"/>
            </xpath>

            <xpath expr="//sheet//group[1]" position="inside">
                <group string="Seguimiento de Compras">
                    <field name="dflex_purchase_process_state" readonly="1"/>
                    <field name="dflex_purchase_process_user_id" readonly="1"/>
                    <field name="dflex_order_deadline_date"/>
                    <field name="dflex_purchase_redo_deadline_date" readonly="1"/>
                    <field name="dflex_execution_deadline_date"/>
                    <field name="dflex_purchase_executed"/>
                    <field name="dflex_purchase_executed_date" readonly="1" invisible="not dflex_purchase_executed_date"/>
                    <field name="dflex_purchase_executed_user_id" readonly="1" invisible="not dflex_purchase_executed_user_id"/>
                    <field name="dflex_purchase_authorized_date" readonly="1" invisible="not dflex_purchase_authorized_date"/>
                    <field name="dflex_purchase_in_process_date" readonly="1" invisible="not dflex_purchase_in_process_date"/>
                    <field name="dflex_purchase_received_date" readonly="1" invisible="not dflex_purchase_received_date"/>
                    <field name="dflex_purchase_redo_date" readonly="1" invisible="not dflex_purchase_redo_date"/>
                    <field name="dflex_purchase_paid_date" readonly="1" invisible="not dflex_purchase_paid_date"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_dflex_purchase_process" model="ir.ui.view">
        <field name="name">purchase.order.list.dflex.purchase.process</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="priority" eval="900"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state'] | //tree/field[@name='state']" position="before">
                <field name="dflex_purchase_process_state"
                       string="Estado compras"
                       widget="badge"
                       optional="show"
                       decoration-success="dflex_purchase_process_state in ['received', 'paid']"
                       decoration-info="dflex_purchase_process_state == 'authorized'"
                       decoration-warning="dflex_purchase_process_state == 'in_process'"
                       decoration-danger="dflex_purchase_process_state == 'redo'"/>
            </xpath>
            <xpath expr="//list/field[@name='date_order'] | //tree/field[@name='date_order']" position="after">
                <field name="dflex_order_deadline_date"
                       string="Fecha límite orden"
                       optional="show"/>
                <field name="dflex_purchase_redo_deadline_date"
                       string="Control cotización"
                       optional="hide"/>
                <field name="dflex_execution_deadline_date"
                       string="Fecha límite ejecución"
                       optional="show"/>
                <field name="dflex_purchase_executed"
                       string="Ejecutada"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- La acción de Solicitudes de cotización usa una vista con KPIs distinta.
         Por eso también heredamos la vista purchase_order_kpis_tree. -->
    <record id="purchase_order_kpis_list_dflex_purchase_process" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.dflex.purchase.process</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="priority" eval="900"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state'] | //tree/field[@name='state']" position="before">
                <field name="dflex_purchase_process_state"
                       string="Estado compras"
                       widget="badge"
                       optional="show"
                       decoration-success="dflex_purchase_process_state in ['received', 'paid']"
                       decoration-info="dflex_purchase_process_state == 'authorized'"
                       decoration-warning="dflex_purchase_process_state == 'in_process'"
                       decoration-danger="dflex_purchase_process_state == 'redo'"/>
            </xpath>
            <xpath expr="//list/field[@name='date_order'] | //tree/field[@name='date_order']" position="after">
                <field name="dflex_order_deadline_date"
                       string="Fecha límite orden"
                       optional="show"/>
                <field name="dflex_purchase_redo_deadline_date"
                       string="Control cotización"
                       optional="hide"/>
                <field name="dflex_execution_deadline_date"
                       string="Fecha límite ejecución"
                       optional="show"/>
                <field name="dflex_purchase_executed"
                       string="Ejecutada"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_dflex_purchase_process" model="ir.ui.view">
        <field name="name">purchase.order.search.dflex.purchase.process</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="priority" eval="450"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="dflex_purchase_authorized"
                        string="Autorizadas"
                        domain="[('dflex_purchase_process_state','=','authorized')]"/>
                <filter name="dflex_purchase_in_process"
                        string="En Proceso"
                        domain="[('dflex_purchase_process_state','=','in_process')]"/>
                <filter name="dflex_purchase_received"
                        string="Recibidas"
                        domain="[('dflex_purchase_process_state','=','received')]"/>
                <filter name="dflex_purchase_paid"
                        string="Pagadas"
                        domain="[('dflex_purchase_process_state','=','paid')]"/>
                <filter name="dflex_purchase_redo"
                        string="Rehacer la orden"
                        domain="[('dflex_purchase_process_state','=','redo')]"/>
                <filter name="dflex_purchase_executed_yes"
                        string="Ejecutadas"
                        domain="[('dflex_purchase_executed','=',True)]"/>
                <filter name="dflex_purchase_executed_no"
                        string="No ejecutadas"
                        domain="[('dflex_purchase_executed','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_dflex_purchase_process_state"
                            string="Estado compras"
                            context="{'group_by': 'dflex_purchase_process_state'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
